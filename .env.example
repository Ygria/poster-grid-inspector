AI_REMOTE_ANALYSIS=0
AI_PROVIDER=openai
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-5.6-terra
AI_TIMEOUT_MS=35000
AI_TOTAL_DEADLINE_MS=50000
AI_MAX_RETRIES=1
AI_IMAGE_DETAIL=original
AI_RESPONSE_FORMAT=json_schema
AI_ENABLE_THINKING=false
PROMPT_VERSION=poster-grid-v2
SCHEMA_VERSION=poster-grid-schema-v2

# Qwen / other OpenAI-compatible example:
# AI_PROVIDER=openai-compatible
# AI_BASE_URL=https://YOUR-ENDPOINT/compatible-mode/v1
# AI_MODEL=qwen3-vl-plus
# AI_RESPONSE_FORMAT=json_object
